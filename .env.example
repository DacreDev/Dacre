# Optional: Dacre Connect source builds. Dacre ships with this off.
# Set these only for a relay and Clerk instance you run yourself.
# Do not add server-side secrets to this file.

# DACRE_CLERK_PUBLISHABLE_KEY=
# DACRE_CLERK_JWT_TEMPLATE=
# DACRE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in DACRE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# DACRE_APPLE_TEAM_ID=ABC1234567
# DACRE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/dacre.provisionprofile
# DACRE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional: your own relay.
# DACRE_RELAY_URL=

# Optional: your own hosted app origin, used by the CLI's out-of-band OAuth flow.
# DACRE_HOSTED_APP_URL=
